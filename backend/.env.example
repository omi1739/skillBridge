# SkillBridge API environment
# Copy this file to .env and fill in values. .env is gitignored (never commit secrets).

# PostgreSQL / Neon connection string
#   Local (Postgres running elsewhere): postgresql://user:pass@localhost:5432/skillbridge
#   Neon: postgresql://USER:PASSWORD@EP.region.aws.neon.tech/skillbridge?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/skillbridge

# API port
PORT=4000

# JWT signing secret (REQUIRED in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional JWT lifetime override (defaults to 7d). Accepts '7d', '12h', '30m', etc.
# JWT_EXPIRES_IN=7d

# Optional GitHub Personal Access Token to raise the API rate limit for
# project repository verification (project.service -> github-verifier).
# Anonymous requests are limited to 60 requests/hour per IP.
GITHUB_TOKEN=

# On boot the API applies the schema and seed data (both idempotent) so a fresh
# deploy self-initializes. Set to false when a migration tool owns the schema.
AUTO_INIT_DB=true

# Demo access control (development convenience).
# Demo token login and demo/staff seed accounts (demo_user_01, admin_user_01,
# owner_user_01, recruiter_user_01) are ENABLED by default outside production
# and DISABLED in production. Set to true to force-enable on a production
# environment, or false to force-disable non-production environments.
# ALLOW_DEMO_TOKEN=true
# SEED_DEMO_USERS=true

# Optional Redis connection string for the caching layer (e.g. landing stats).
# When unset, the API transparently falls back to a short-lived in-memory cache.
#   Local:   redis://localhost:6379
#   Managed (e.g. Upstash): rediss://:TOKEN@HOST:6379
REDIS_URL=

# Google Sign-In (optional). Create OAuth Web client credentials at
# https://console.cloud.google.com/apis/credentials . When GOOGLE_CLIENT_ID is
# set, /api/auth/google verifies the ID token's audience against it.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# CORS: comma-separated list of allowed frontend origins in production.
# When unset, the API reflects any origin (dev). Example:
# CORS_ORIGIN=https://skillbridge.vercel.app
CORS_ORIGIN=

# Optional OpenAI API key for LLM-generated sandbox challenges.
# When set, the sandbox "Generate New Challenge" endpoint calls the configured
# model to produce a fresh SQL or JavaScript challenge on demand. When unset,
# it falls back to a curated offline challenge bank so the feature still works.
OPENAI_API_KEY=

# Optional model override for sandbox challenge generation. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# --- Job ingestion tuning (defaults shown) ---
# The default public job-board API used by the ingestion pipeline.
# JOB_API_URL=https://www.arbeitnow.com/api/job-board-api
# How many result pages to pull per ingestion run (Arbeitnow).
# JOB_API_PAGES=3
# Minimum number of ontology skill matches required to classify a posting as
# engineering-related. Defaults to 1.
# JOB_MIN_MATCHES=1
# Display name recorded for the Arbeitnow source in the job_sources table.
# JOB_SOURCE_NAME=Arbeitnow
# How many listing pages BdJobs scrapes per run.
# JOB_BD_PAGES=4
# Default source used by `npm run db:ingest` when none is passed (arbeitnow|bdjobs).
# JOB_INGEST_SOURCE=arbeitnow
# Jobs older than this many days are expired (removed from demand stats) even if
# the source has not re-checked them recently.
# JOB_EXPIRE_DAYS=4
# Jobs beyond this age are hard-deleted during the verification sweep.
# JOB_RETENTION_DAYS=7

# --- Assessment engine tuning ---
# In-memory assessment session lifetime in ms (default 24h).
# ASSESSMENT_TTL_MS=86400000
# Allowed time per question in minutes for the running timer (default 2).
# ASSESSMENT_MINUTES_PER_QUESTION=2

# --- AI question generation (skill assessment bank) ---
# Free tier (recommended): Google Gemini via AI Studio.
# Get a key at https://aistudio.google.com/apikey (no billing required).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
#
# Paid fallback: OpenAI (only used if GEMINI_API_KEY is unset).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# When no key is set at all, assessments gracefully fall back to the seeded
# question bank and AI generation is disabled until a key is provided.


