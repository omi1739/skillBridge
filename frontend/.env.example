# Backend API base URL (with /api suffix)
NEXT_PUBLIC_API_BASE=http://localhost:4000/api

# Google Sign-In client ID (optional). Enables the "Continue with Google" button
# in the sign-in / register modal. Leave blank to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Client-side request timeout in ms (default 20000). A request that does not
# respond in time is aborted and surfaces a "request timed out" message instead
# of spinning forever.
# NEXT_PUBLIC_API_TIMEOUT_MS=20000

# AI generation (question bank / sandbox) can take longer than CRUD calls.
# Default 45000; the backend enforces a 40s provider budget.
# NEXT_PUBLIC_AI_TIMEOUT_MS=45000

# Project health runs a live GitHub scan plus an optional AI review.
# NEXT_PUBLIC_HEALTH_CHECK_TIMEOUT_MS=40000

