{
  "name": "skillbridge",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-Based Labor Market Intelligence & Skill Assessment Platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --workspace=@skillbridge/api",
    "dev:frontend": "npm run dev --workspace=@skillbridge/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:setup": "npm run db:setup --workspace=@skillbridge/api",
    "db:seed": "npm run db:seed --workspace=@skillbridge/api"
  },
  "keywords": [
    "labor-market-intelligence",
    "skill-assessment",
    "skill-gap-analysis",
    "career-development"
  ],
  "author": "SkillBridge Team",
  "license": "MIT"
}
